[Unit]
Description=AGZS Station Edge Shift Monitor on tty1 (No-Login Read-Only Display)
After=station-edge.service
Wants=station-edge.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=station-edge
Group=tty
SupplementaryGroups=station-edge
WorkingDirectory=/var/lib/station-edge
EnvironmentFile=/opt/station-edge/.env
Environment=TERM=linux
Environment=PYTHONUNBUFFERED=1
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
ExecStartPre=-/usr/bin/setfont Uni3-TerminusBold24x12
ExecStartPre=-/usr/bin/setterm -blank 0 -powerdown 0
ExecStart=/opt/station-edge/.venv/bin/python -m agzs_edge monitor --kiosk
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/station-edge

[Install]
WantedBy=multi-user.target
