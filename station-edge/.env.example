# --- Линия связи АСКА-02 (FTDI FT232R, 9600 8N1) ---
# На Windows: COM7; на Linux предпочтительно /dev/serial/by-id/...FTDI... (ttyUSB0 тоже ок — подставится by-id)
AGZS_SERIAL_PORT=COM7
AGZS_SERIAL_BAUDRATE=9600
AGZS_SERIAL_BYTESIZE=8
AGZS_SERIAL_PARITY=N
AGZS_SERIAL_STOPBITS=1
# Таймаут ожидания ответа от АСКА-02 (сек; не менее 1.0, чтобы не терять медленный ответ колонки)
AGZS_SERIAL_TIMEOUT_SEC=1.5
# Адреса опрашиваемых колонок УЗГС-01 (через запятую, диапазон 1..8).
# На REKON подключена одна колонка — адрес 1.
AGZS_PUMP_ADDRESSES=1
# Интервал между циклами опроса (сек.)
AGZS_POLL_INTERVAL_SEC=0.5
# Пауза полудуплекса RS-232 между последовательными кадрами АСКА-02 (сек.)
AGZS_INTER_FRAME_DELAY_SEC=0.05
# Режим: serial (живой порт АСКА-02) или emulator (имитатор кадров без колонки)
AGZS_SOURCE_MODE=serial
# Протокол: только подтверждённые. iskra_172 — текущий (Протокол Техно Проект v3.10).
AGZS_PROTOCOL=iskra_172
# Штатный режим с блоком питания вместо пульта: 0 = после останова '07'/'04' служба гасит насос (0x36) и шлёт «Сброс» 0x37.
# 1 = только чтение «Тест» (0x34), без команд 0x35/0x36/0x37/0x38 на колонку.
AGZS_READ_ONLY=0
# Отправлять ОСТАНОВ (0x36) сразу при выходе колонки из пуска ('03' -> '07'/'04') для мгновенного снятия НАСОС+/НАСОС- на АСКА-02;
# литры и сумма при этом остаются на табло колонки до команды СБРОС (0x37).
AGZS_AUTO_STOP_ON_FINISH=1
# Автосброс '07' → '05' командой 0x37. Для блока питания без пульта должно быть 1.
AGZS_AUTO_RESET=1
# Пауза перед автосбросом после '07' (сек., 15 с хватает для чтения литров и суммы на табло)
AGZS_AUTO_RESET_DELAY_SEC=15.0
# Пауза перед автосбросом '04' СТОП в '05' (сек., 0 = без автосброса; учёт при '04' закрывается сразу без паузы)
AGZS_AUTO_RESET_STOPPED_DELAY_SEC=0
# Интервал сверки суммарного счётчика (0.11) во время простоя в '05' (сек., 0 = выкл по умолчанию до проверки 0x38 на АСКА-02)
AGZS_COUNTER_RECONCILE_INTERVAL_SEC=0

# --- Смещения 23-байтного кадра «Искра 1.72» (калибруются на стенде при необходимости) ---
# Режим проверки контрольной суммы: xor | sum7 | sum8 | any
AGZS_ISKRA_CHECKSUM_MODE=xor

# --- Локальная база данных станции (SQLite WAL) ---
AGZS_DB_PATH=station_edge.db
# Сохранять ли каждый сырой кадр в кольцевой буфер raw_frames (1 = да, 0 = только при смене/ошибке)
AGZS_SAVE_RAW_FRAMES=0
# Каждый ответ TEST в журнал: HEX, оба байта Status, оба байта Sost, поле, объём, BCC.
# Пока включено, опрос не шлёт 0x38/000016, чтобы не смешивать запись с нажатиями.
AGZS_TRACE_FRAMES=0

# --- Привязка к центральному серверу (VPS) ---
AGZS_VPS_BASE_URL=http://93.171.232.47
AGZS_DEVICE_TOKEN=
AGZS_STATION_CODE=AKT-12MKR
AGZS_STATION_ID=a2222222-2222-2222-2222-222222222201
AGZS_TANK_ID=b2222222-2222-2222-2222-222222222201
# Карта соответствия адреса колонки (1..8) и UUID колонки в базе VPS
# Формат: 1:d2222222-2222-2222-2222-222222222201,2:d2222222-2222-2222-2222-222222222202
AGZS_DISPENSER_MAP=1:d2222222-2222-2222-2222-222222222201,2:d2222222-2222-2222-2222-222222222202
# Включить фоновую отправку очереди outbox на VPS (1 = да, 0 = только локальная запись)
AGZS_SYNC_ENABLED=1
AGZS_SYNC_INTERVAL_SEC=5.0

# --- Экранный монитор смены (команда `agzs_edge monitor` / tty1 без входа в систему) ---
# Час начала смены (0..23): например 8 для смен 08:00-20:00 / 20:00-08:00, либо 0 для суточной смены
AGZS_SHIFT_START_HOUR=8
# Длительность смены в часах (1..24): 12 для дневной/ночной смены, 24 для суточной
AGZS_SHIFT_HOURS=12
# Интервал обновления табло на мониторе (сек.)
AGZS_MONITOR_REFRESH_SEC=2.0
# Режим киоска на /dev/tty1 (1 = блокировать Ctrl+C / Ctrl+Z / Ctrl+\)
AGZS_MONITOR_KIOSK=0
# Символ валюты для цены и суммы
AGZS_CURRENCY=₸

# --- Массовое Pull-автообновление с центрального VPS ---
# Кольцо обновлений:
#   ring0 (или canary) — 1–2 станции рядом с инженером (обкатка сутки)
#   ring1              — 10% станций (обкатка 1 смену)
#   ring2 (или stable) — остальные 90% (обновление во время простоя)
AGZS_UPDATE_CHANNEL=stable
# Сколько секунд тишины после последней заправки считать простоем станции перед началом обновления
AGZS_UPDATE_IDLE_QUIET_SEC=60
# Отключать ли кнопки на корпусе колонки командой 0x38 (0.17/0.16) при обновлении ПО (0 = выкл по умолчанию, до проверки формата Price на живой АСКА-02)
AGZS_LOCK_BUTTONS_ON_UPDATE=0
# Режим кнопок на колонке. В готовности '05' служба сама шлёт 0x38, если биты кадра не совпадают:
# enable (0.16: ПУСК/СТОП/СБРОС вкл) или lock-reset (0.18: ПУСК/СТОП вкл, СБРОС заблок.)
AGZS_PUMP_BUTTONS_MODE=enable
# Каталог для скачивания .whl пакетов и хранения ссылки на предыдущую рабочую версию (откат)
AGZS_RELEASES_DIR=releases
# Обязательная проверка HMAC-SHA256 подписи манифеста релиза (1 = fail-closed: без ключа обновление отклоняется)
AGZS_REQUIRE_RELEASE_SIGNATURE=1
# Общий секрет подписи релизов (должен совпадать с EDGE_RELEASE_SIGNING_KEY на VPS)
AGZS_RELEASE_SIGNING_KEY=
