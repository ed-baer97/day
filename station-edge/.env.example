# --- Линия связи АСКА-02 (FTDI FT232R, 9600 8N1) ---
# На Windows: COM7; на Linux: /dev/ttyUSB0
AGZS_SERIAL_PORT=COM7
AGZS_SERIAL_BAUDRATE=9600
AGZS_SERIAL_TIMEOUT_SEC=0.25
# Адреса опрашиваемых колонок УЗГС-01 (через запятую, диапазон 1..6)
AGZS_PUMP_ADDRESSES=1,2
# Интервал между циклами опроса (сек.)
AGZS_POLL_INTERVAL_SEC=0.5
# Режим: serial (живой порт АСКА-02) или emulator (имитатор кадров без колонки)
AGZS_SOURCE_MODE=serial

# --- Смещения 23-байтного кадра «Искра 1.72» (калибруются на стенде при необходимости) ---
# Режим проверки контрольной суммы: xor | sum7 | sum8 | any
AGZS_ISKRA_CHECKSUM_MODE=xor

# --- Локальная база данных станции (SQLite WAL) ---
AGZS_DB_PATH=station_edge.db
# Сохранять ли каждый сырой кадр в кольцевой буфер raw_frames (1 = да, 0 = только при смене/ошибке)
AGZS_SAVE_RAW_FRAMES=0

# --- Привязка к центральному серверу (VPS) ---
AGZS_VPS_BASE_URL=http://93.171.232.47
AGZS_DEVICE_TOKEN=
AGZS_STATION_CODE=AKT-12MKR
AGZS_STATION_ID=a2222222-2222-2222-2222-222222222201
AGZS_TANK_ID=b2222222-2222-2222-2222-222222222201
# Карта соответствия адреса колонки (1..6) и UUID колонки в базе VPS
# Формат: 1:d2222222-2222-2222-2222-222222222201,2:d2222222-2222-2222-2222-222222222202
AGZS_DISPENSER_MAP=1:d2222222-2222-2222-2222-222222222201,2:d2222222-2222-2222-2222-222222222202
# Включить фоновую отправку очереди outbox на VPS (1 = да, 0 = только локальная запись)
AGZS_SYNC_ENABLED=1
AGZS_SYNC_INTERVAL_SEC=5.0
